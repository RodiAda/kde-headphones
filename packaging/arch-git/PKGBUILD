# Maintainer: Rodion Adamenok <https://github.com/RodiAda>

pkgname=kde-headphones-git
_pkgname=kde-headphones
pkgver=0.2.0.r0.g65d0d95
pkgrel=1
pkgdesc="KDE Plasma tray widget for Bluetooth headphones (git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/RodiAda/kde-headphones"
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-declarative' 'libplasma' 'kirigami'
         'plasma-workspace' 'dbus' 'bluez' 'bluez-libs')
makedepends=('cmake' 'ninja' 'git' 'gettext')
provides=("$_pkgname")
conflicts=("$_pkgname")
_fmtver=12.1.0
source=("git+$url.git"
        "git+https://github.com/mos9527/SonyHeadphonesClient.git"
        "fmt-$_fmtver.tar.gz::https://github.com/fmtlib/fmt/archive/refs/tags/$_fmtver.tar.gz")
sha256sums=('SKIP'
            'SKIP'
            'ea7de4299689e12b6dddd392f9896f08fb0777ac7168897a244a6d6085043fea')

pkgver() {
  cd "$srcdir/$_pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$srcdir/$_pkgname"
  git submodule init
  git config submodule.third_party/SonyHeadphonesClient.url "$srcdir/SonyHeadphonesClient"
  git -c protocol.file.allow=always submodule update

  cd "$srcdir/fmt-$_fmtver"
  patch -Np1 -i "$srcdir/$_pkgname/third_party/SonyHeadphonesClient/contrib/fmt.patch"
}

build() {
  cmake -B build -S "$_pkgname" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DHEADPHONES_TESTS=ON \
    -DFETCHCONTENT_SOURCE_DIR_FMT="$srcdir/fmt-$_fmtver" \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
  cmake --build build
}

check() {
  build/galaxy-test
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
