[Unit]
Description=Headphones control daemon (D-Bus io.github.rodiada.Headphones)
PartOf=graphical-session.target
Wants=mpris-proxy.service
After=graphical-session.target bluetooth.target

[Service]
Type=dbus
BusName=io.github.rodiada.Headphones
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/headphonesd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
